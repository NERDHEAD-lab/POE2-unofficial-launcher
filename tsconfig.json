{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@poe2-launcher/launcher": ["packages/launcher/src"],
      "@poe2-launcher/launcher/*": ["packages/launcher/src/*"],
      "@poe2-launcher/pob-bridge": ["packages/pob-bridge/src"],
      "@poe2-launcher/pob-bridge/*": ["packages/pob-bridge/src/*"],
      "@poe2-launcher/pob-ui": ["packages/pob-ui/src"],
      "@poe2-launcher/pob-ui/*": ["packages/pob-ui/src/*"],
      "@poe2-launcher/pob-repoe": ["packages/pob-repoe/src"],
      "@poe2-launcher/pob-repoe/*": ["packages/pob-repoe/src/*"],
      "@poe2-launcher/pob-vault": ["packages/pob-vault/src"],
      "@poe2-launcher/pob-vault/*": ["packages/pob-vault/src/*"],
      "@poe2-launcher/shared": ["packages/shared/src"],
      "@poe2-launcher/shared/*": ["packages/shared/src/*"]
    },
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/launcher/src",
    "packages/shared/src",
    "packages/pob-repoe/src",
    "packages/pob-vault/src",
    "packages/pob-bridge/src",
    "packages/pob-ui/src",
    "packages/pob-unofficial-wrapper/src"
  ]
}
