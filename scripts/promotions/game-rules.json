{
  "rules": [
    {
      "type": "regex",
      "value": "Path of Exile(?:\\s+1)?\\s+(?:category|directory|stream)",
      "games": { "poe1": true, "poe2": false }
    },
    {
      "type": "regex",
      "value": "Path of Exile\\s+2\\s+(?:category|directory|stream)",
